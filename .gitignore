# dependencies
node_modules/

# Expo
.expo/
.expo-export-test/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# test exports
.expo-export-test/

# test coverage
coverage/

# Cloudflare Worker
.wrangler/
worker/worker-configuration.d.ts
# Worker secrets for local runs: never committed
worker/.dev.vars
worker/.dev.vars.*

# YMove exercise videos are licensed only while the subscription is active
# and must not be redistributed (API terms, sections 2 and 5): never committed.
assets/ymove-trial/
src/assets/ymove-media.generated.ts

# Evaluation reports are build output. A run worth keeping is added on purpose (git add -f).
evals/reports/*
!evals/reports/.gitkeep
