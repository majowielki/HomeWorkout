{
  // The coach Worker: a stateless proxy between the app and a language model.
  // See ../docs/adr/0002-data-and-domain-stay-on-the-phone.md and README.md here.
  "name": "homeworkout-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  "vars": {
    // "google" calls the provider; local development uses src/dev.ts, which swaps in a fake.
    "PROVIDER": "google",
    // Chosen from the provider's published model list (ai.google.dev/gemini-api/docs/models, 2026-10-02).
    // A starting point, not the verdict: the evaluation decides (decision D3). First live run on
    // gemini-3.8-flash (2026-10-02): the API answered 503 in 4 of 10 calls and took 2-16 s to the first
    // event for tiny answers; trying gemini-3.5-flash-lite, which Google also recommends for new projects.
    "MODEL_ID": "gemini-3.5-flash-lite",
    // Hard stop for the day, counted in input + output tokens. A fence, not an accounting system.
    "DAILY_TOKEN_BUDGET": "150000",
    // Thinking tokens count against this, so it is generous; it caps one call, not the day.
    "MAX_OUTPUT_TOKENS": "2048",
    // minimal | low | medium | high. Gemini 3 thinks at medium by default, which is many seconds a step.
    "THINKING_LEVEL": "low",
    // For the estimated cost in logs: gemini-3.5-flash-lite, ai.google.dev/gemini-api/docs/pricing,
    // 2026-10-02. Shown even on the free tier (it is what the call would cost on the paid one).
    "PRICE_INPUT_USD_PER_MTOK": "0.30",
    "PRICE_OUTPUT_USD_PER_MTOK": "2.50",
  },

  // Daily token counter. `wrangler kv namespace create BUDGET`, then paste the id.
  "kv_namespaces": [{ "binding": "BUDGET", "id": "00000000000000000000000000000000" }],

  // Requests per minute, per Worker location. Cheap protection against a runaway client.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    // The chat asks once per tool round, so one question is up to five requests.
    { "name": "CHAT_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
  ],

  // One zod for the Worker and for the contract imported from ../src (research R11):
  // without this the bundle holds two copies.
  "alias": { "zod": "./node_modules/zod/index.js" },

  // Structured JSON lines from src/log.ts land in Workers Logs. Metadata only, never content.
  "observability": { "enabled": true },
}
